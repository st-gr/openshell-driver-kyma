# Build artifacts
target/
**/*.rs.bk
*.pdb

# Local reference clones (read-only inspiration; not part of this repo)
reference-openshift/

# Sockets and lock files
*.sock

# Kubeconfig (NEVER commit cluster credentials)
kubeconfig*
*.kubeconfig
.kube/

# Local scratch dir for the dev container (rendered kubeconfigs etc.)
.tmp/

# Environment files
.env
.env.*
!.env.example

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Coverage and profiling
coverage/
*.profraw
lcov.info

# Distribution
dist/
*.tgz

# Note: Cargo.lock IS committed for binary crates (we ship binaries).

# Self-hosted runner: secret hygiene safety net. The real Secret is
# created via `kubectl create secret` — never via a YAML file. These
# patterns prevent accidental commits if anyone ignores the README.
deploy/runner/secret.yaml
deploy/runner/secrets.yaml
deploy/runner/.env*
**/runner-token-*.txt
**/registration-token-*.txt
**/*.pat
**/*-pat.txt
**/anthropic-token-*.txt

# SAP BTP service-key files (clientid + clientsecret + tenant URL).
# Operators drop these next to the repo for local cargo-test use; they
# must never land in git. Pre-flight `git check-ignore -v sk-<name>.json`
# before any commit on a branch that touches the bedrock-bridge.
sk-*.json
*.sap-key.json
service-key*.json
**/sap-aicore-*.json

# Node module noise from scripts/ if anyone runs `npm install` ad-hoc
scripts/node_modules/

.claude/

# Screenshots and other operator-environment artifacts that may carry
# subaccount UUIDs, tunnel IDs, support emails, or hostnames. The
# repo intentionally has no committed design assets — anything matching
# the patterns below is operator-private and must never land here.
sensitive-*
*-gitignore.*
*PII*
*pii*
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
# Specific filename safety net for the SCC screenshot.
sensitive-PII-created-sap-cloud-connector-gitignore.png
